# Database connection
SR_GEN_DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# Dimension table for listing apps (required for /apps/db endpoint)
SR_GEN_DB_APP_LIST_TABLE=app_identifier
SR_GEN_DB_APP_LIST_ID_COLUMN=id
SR_GEN_DB_APP_LIST_NAME_COLUMN=app_name

# API key for authentication (optional, leave empty to disable)
SR_GEN_API_KEY=

# Server
HOST=0.0.0.0
PORT=8321
UVICORN_RELOAD=false
