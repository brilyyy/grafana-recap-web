{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "Astro docs": {
      "type": "remote",
      "url": "https://mcp.docs.astro.build/mcp",
      "enabled": true
    },
    "shadcn": {
      "type": "local",
      "command": [
        "bunx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    }
  }
}
