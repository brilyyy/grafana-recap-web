# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=grafana_recap

# BetterAuth
BETTER_AUTH_SECRET=change-me-to-a-random-secret
BETTER_AUTH_URL=http://localhost:3000
# BETTER_AUTH_TRUSTED_ORIGINS=https://example.com,https://app.example.com

# Scheduler
SCHEDULER_TIMEZONE=Asia/Jakarta

# Logging
LOG_LEVEL=info
LOG_DIR=log

# App
NODE_ENV=production

# sr-gen API (report generator)
SR_GEN_API_KEY=change-me-to-an-api-key
# Optional: explicit DB connection string (defaults to DB_* vars above)
# SR_GEN_DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Migrations / seeds (optional)
# TARGET_DATABASES=db1,db2
# DEFAULT_SU_USERNAME=admin
# DEFAULT_SU_PASSWORD=admin
# DEFAULT_SU_EMAIL=admin@example.com
